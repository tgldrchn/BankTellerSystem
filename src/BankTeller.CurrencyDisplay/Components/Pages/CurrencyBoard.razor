@page "/"
@rendermode InteractiveServer
@using BankTeller.Core.Models
@using BankTeller.Core.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<PageTitle>Валютын ханш</PageTitle>

<div class="cb-window">

    <div class="cb-titlebar">
        <span class="cb-dot dot-red"></span>
        <span class="cb-dot dot-yellow"></span>
        <span class="cb-dot dot-green"></span>
        <span class="cb-wintitle">₮&nbsp; Валютын ханш — Blazor</span>
    </div>

    <div class="cb-body">

        <div class="cb-toprow">
            <span class="cb-heading">Валютын ханш</span>
            <span class="cb-time">Сүүлд: <strong>@_lastUpdated.ToString("HH:mm:ss")</strong></span>
        </div>

        @if (_rates == null)
        {
            <p class="cb-muted">Ачааллаж байна...</p>
        }
        else if (!_rates.Any())
        {
            <p class="cb-muted">Мэдээлэл байхгүй байна.</p>
        }
        else
        {
            <div class="cb-cards">
                @foreach (var rate in _rates)
                {
                    <div class="cb-card @GetCardClass(rate.CurrencyCode)">
                        <div class="cb-code">@rate.CurrencyCode</div>
                        <div class="cb-row">
                            <span class="cb-label">Авах:</span>
                            <span class="cb-val">@rate.BuyRate.ToString("N0")</span>
                        </div>
                        <div class="cb-sell-val @GetSellClass(rate.CurrencyCode)">
                            @rate.SellRate.ToString("N0") ₮
                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="cb-error">@_error</p>
        }

        <p class="cb-status">
            @if (_hubConnection?.State == HubConnectionState.Connected)
            {
                <span class="cb-dot-status dot-ok"></span>
                <span>SignalR: ханш шинэчлэгдлээ</span>
            }
            else
            {
                <span class="cb-dot-status dot-err"></span>
                <span>SignalR: холбогдож байна...</span>
            }
        </p>

    </div>
</div>

@code {
    private List<CurrencyRate>? _rates;
    private DateTime _lastUpdated = DateTime.Now;
    private string _error = "";
    private HubConnection? _hubConnection;

    private string GetCardClass(string code) => code switch
    {
        "CNY" => "cb-card--highlight-green",
        "RUB" => "cb-card--highlight-red",
        _ => ""
    };

    private string GetSellClass(string code) => code switch
    {
        "CNY" => "sell-green",
        "RUB" => "sell-red",
        _ => "sell-default"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadRatesAsync();
        await ConnectSignalRAsync();
    }

    private async Task LoadRatesAsync()
    {
        try
        {
            using var http = new HttpClient();
            var response = await http.GetFromJsonAsync<ApiResponse<List<CurrencyRate>>>(
                "http://localhost:5200/api/currency");
            _rates = response?.Data ?? new List<CurrencyRate>();
            _lastUpdated = DateTime.Now;
            _error = "";
        }
        catch (Exception ex)
        {
            _error = $"Алдаа: {ex.Message}";
            _rates = new List<CurrencyRate>();
        }
    }

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl("http://localhost:5200/hubs/bank")
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("RateUpdated", async () =>
            {
                await LoadRatesAsync();
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            _error = $"SignalR алдаа: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}